<h1>Editar Produto</h1>

<form action="/produtos/{{produtos.id}}?_method=PUT" method="POST">

  <div>
    <label>Nome:</label>
    <input type="text" name="nome" value="{{produtos.nome}}">
  </div>

  <br>

  <div>
    <label>Ano:</label>
    <input type="number" name="ano" value="{{produtos.ano}}">
  </div>

  <br>

  <div>
    <label>Categoria:</label>
    <select name="categoriaId">
      {{#each categorias}}
        <option value="{{this.id}}" {{#if (eq this.id @root.produtos.categoriaId)}}selected{{/if}}>
          {{this.nome}}
        </option>
      {{/each}}
    </select>
  </div>

  <br>

  <div>
    <label>Tamanhos:</label>
    <select name="tamanhos" multiple>
      {{#each tamanhos}}
        <option value="{{this.id}}">{{this.nome}}</option>
      {{/each}}
    </select>
  </div>

  <button type="submit">
    Editar
  </button>
</form>
