<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<h1>Lista de tamanhos</h1>

<a href="/">Inicial</a><br>

<a href="/tamanho/cadastrar">Cadastrar Tamanho</a>

<hr>

<ul>
  {{#each tamanho}}
    <li>
      <a href="/tamanho/{{this.id}}">{{this.nome}}</a>
      <a href="/tamanho/{{this.id}}/editar"><i class="fa-solid fa-pen-to-square"></i></a>
      <form action="/tamanho/{{this.id}}?_method=DELETE" method="POST" style="display:inline;">
        <button type="submit"><i class="fa-solid fa-trash-can"></i></button>
      </form>
    </li>
  {{/each}}
</ul>


