<h1>Editar Categoria</h1>

<form action="/categorias/{{categoria.id}}?_method=PUT" method="POST">

  <div>
    <label>Nome:</label>
    <input type="text" name="nome" value="{{categoria.nome}}">
  </div>

  <br>

  <div>
    <label>Ano:</label>
    <input type="number" name="anoNascimento" value="{{categoria.anoNascimento}}">
  </div>

  <br>

  <div>
    <label>Nacionalidade:</label>
    <input type="text" name="nacionalidade" value="{{categoria.nacionalidade}}">
  </div>

  <br>

  <button type="submit">Editar</button>

</form>
