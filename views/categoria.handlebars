<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<h1>Lista de categoria</h1>

<a href="/">
  Inicial
</a><br>

<a href="/categoria/cadastrar">
  Cadastrar Diretor
</a>



<hr>

<ul>

  {{#each categoria}}

    <li>
      <a href="/categoria/{{this.id}}">{{this.nome}} - {{this.anoNascimento}} - {{this.nacionalidade}}</a>

      <a href="/categoria/{{this.id}}/editar"><i class="fa-solid fa-pen-to-square"></i></a>
      
      <form action="/categoria/{{this.id}}?_method=DELETE" method="POST" style="display: inline;">
        <button type="submit"><i class="fa-solid fa-trash-can"></i></button>
      </form>
    </li>

  {{/each}}

</ul>

